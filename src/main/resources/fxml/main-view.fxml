<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pictool.controller.MainController" spacing="8">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="源目录:" minWidth="48"/>
        <ListView fx:id="sourceList" prefHeight="88" HBox.hgrow="ALWAYS"/>
        <VBox spacing="6">
            <Button fx:id="addSourceBtn" text="添加…" onAction="#onAddSource" minWidth="72"/>
            <Button fx:id="removeSourceBtn" text="移除" onAction="#onRemoveSource" minWidth="72"/>
        </VBox>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="目标目录:" minWidth="48"/>
        <TextField fx:id="targetField" editable="false" HBox.hgrow="ALWAYS"/>
        <Button fx:id="browseTargetBtn" text="浏览…" onAction="#onBrowseTarget" minWidth="72"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="startBtn" text="开始导入" onAction="#onStartImport" defaultButton="true"/>
        <Button fx:id="rebuildIndexBtn" text="重建目标索引" onAction="#onRebuildIndex"/>
        <Button fx:id="cancelBtn" text="取消" onAction="#onCancel" disable="true"/>
        <ProgressBar fx:id="progressBar" prefWidth="240"/>
        <Label fx:id="statusLabel" text="就绪" HBox.hgrow="ALWAYS"/>
    </HBox>

    <TabPane fx:id="mainTabs" VBox.vgrow="ALWAYS">
        <Tab text="日志" closable="false">
            <TextArea fx:id="logArea" editable="false"/>
        </Tab>
        <Tab text="媒体展示" closable="false">
            <VBox spacing="8">
                <padding>
                    <Insets top="8" right="8" bottom="8" left="8"/>
                </padding>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="开始日期:"/>
                    <DatePicker fx:id="startDatePicker" prefWidth="120"/>
                    <Label text="结束日期:"/>
                    <DatePicker fx:id="endDatePicker" prefWidth="120"/>
                    <Label text="排序:"/>
                    <ComboBox fx:id="sortCombo" prefWidth="110"/>
                    <Button fx:id="refreshGalleryBtn" text="刷新" onAction="#onRefreshGallery"/>
                    <Label fx:id="resultInfoLabel" text=""/>
                </HBox>
                <Pagination fx:id="galleryPagination" VBox.vgrow="ALWAYS"
                            maxPageIndicatorCount="12" styleClass="pagination"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
